{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreFiles": [".claude/**", "sheriff.config.ts"],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/vite",
    "@testing-library/react",
    "@fullstack-forge/api-spec",
    "@fullstack-forge/design-system",
    "@suspensive/react",
    "@suspensive/react-query",
    "@hono/node-server"
  ],
  "exclude": ["unresolved", "catalog"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@vitest/coverage-v8", "@hey-api/openapi-ts", "vitest"]
    },
    "apps/*": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api-spec": {
      "entry": ["src/routes/*/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["generated/**"]
    },
    "packages/design-system": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts", "src/hooks/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
